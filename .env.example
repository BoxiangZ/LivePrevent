# 复制为 .env.local 并填入实际值。不要提交 .env.local。

# --- Kimi（Moonshot AI）---
# 模型调用层抽象见 src/lib/llm/，可替换为任意 OpenAI 兼容端点或私有部署 — PRD §10.4
# 不填 KIMI_API_KEY 也能跑：自动降级为模板摘要（PRD §10.3）
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3
# kimi-k3 响应约 10-20s，建议 ≥25000；超时后自动降级模板，不影响警报链
KIMI_TIMEOUT_MS=25000

# 设为 1 强制走模板降级（不调用 Kimi，用于离线排练）
DEMO_KIMI_OFFLINE=0

# --- App ---
# Demo 时间轴加速倍数（恢复观察窗 3min→10s 等）— PRD §19
NEXT_PUBLIC_DEMO_TIME_SCALE=18
